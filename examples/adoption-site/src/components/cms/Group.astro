---
interface Props {
  cmsAttributes?: Record<string, string>;
  gap?: "tight" | "normal" | "roomy";
  align?: "start" | "center";
  editorId?: string;
  editorSlot?: string;
}

const { gap = "normal", align = "start", editorId, editorSlot } = Astro.props;
const { class: cmsClass, ...cmsAttributes } = Astro.props.cmsAttributes ?? {};
---

<div
  {...cmsAttributes}
  class:list={["group", `group--${gap}`, `group--${align}`, cmsClass]}
  data-astro-cms-node={editorId}
  data-astro-cms-slot={editorSlot}
>
  <slot />
</div>

<style>
  @layer astro-cms-defaults {
    .group {
      display: flex;
      flex-direction: column;
    }

    .group--tight {
      gap: 0.75rem;
    }

    .group--normal {
      gap: 1.5rem;
    }

    .group--roomy {
      gap: 2.75rem;
    }

    .group--start {
      align-items: flex-start;
      text-align: left;
    }

    .group--center {
      align-items: center;
      text-align: center;
    }
  }
</style>
