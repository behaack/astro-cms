---
interface Props {
  tone?: "plain" | "soft" | "brand";
  width?: "narrow" | "wide" | "full";
  editorId?: string;
}

const { tone = "plain", width = "wide", editorId } = Astro.props;
---

<section
  class:list={["cms-section", `cms-section--${tone}`]}
  data-astro-cms-node={editorId}
>
  <div class:list={["cms-section__inner", `cms-section__inner--${width}`]}>
    <slot />
  </div>
</section>

<style>
  .cms-section {
    padding: clamp(4rem, 9vw, 8rem) clamp(1.25rem, 5vw, 5rem);
  }

  .cms-section--plain {
    background: #f8faf7;
  }

  .cms-section--soft {
    background: #e7eee9;
  }

  .cms-section--brand {
    color: #f7fff9;
    background:
      radial-gradient(circle at 80% 20%, #447663 0, transparent 35%),
      #173c30;
  }

  .cms-section__inner {
    margin-inline: auto;
  }

  .cms-section__inner--narrow {
    max-width: 48rem;
  }

  .cms-section__inner--wide {
    max-width: 74rem;
  }

  .cms-section__inner--full {
    max-width: none;
  }
</style>
