---
interface Props {
  cmsAttributes?: Record<string, string>;
  gap?: "small" | "medium" | "large";
  align?: "start" | "center";
  editorId?: string;
  editorSlot?: string;
}

const { gap = "medium", align = "start", editorId, editorSlot } = Astro.props;
const { class: cmsClass, ...cmsAttributes } = Astro.props.cmsAttributes ?? {};
---

<div
  {...cmsAttributes}
  class:list={[
    "cms-stack",
    `cms-stack--${gap}`,
    `cms-stack--${align}`,
    cmsClass,
  ]}
  data-astro-cms-node={editorId}
  data-astro-cms-slot={editorSlot}
>
  <slot />
</div>

<style>
  @layer astro-cms-defaults {
    .cms-stack {
      display: flex;
      flex-direction: column;
    }

    .cms-stack--small {
      gap: 0.75rem;
    }

    .cms-stack--medium {
      gap: 1.5rem;
    }

    .cms-stack--large {
      gap: clamp(2rem, 5vw, 4rem);
    }

    .cms-stack--start {
      align-items: flex-start;
    }

    .cms-stack--center {
      align-items: center;
      text-align: center;
    }
  }
</style>
