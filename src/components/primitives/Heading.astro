---
import { formattedTextHtml } from "../../cms/text-formatting";
import type { TextFormat } from "../../cms/document-types";
interface Props {
  cmsTextFormatting?: Record<string, TextFormat[]>;
  cmsAttributes?: Record<string, string>;
  text: string;
  level?: 1 | 2 | 3;
  editorId?: string;
}

const { text, level = 2, editorId } = Astro.props;
const Tag = `h${level}` as "h1" | "h2" | "h3";
const { class: cmsClass, ...cmsAttributes } = Astro.props.cmsAttributes ?? {};
---

<Tag
  {...cmsAttributes}
  class:list={["cms-heading", cmsClass]}
  data-astro-cms-node={editorId}
  data-astro-cms-text={editorId ? "text" : undefined}
  set:html={formattedTextHtml(text, Astro.props.cmsTextFormatting?.text)}
/>

<style>
  @layer astro-cms-defaults {
    .cms-heading {
      max-width: 18ch;
      margin: 0;
      font-size: clamp(2.2rem, 6vw, 5.6rem);
      font-weight: 650;
      letter-spacing: -0.055em;
      line-height: 0.98;
      text-wrap: balance;
    }

    h2.cms-heading {
      font-size: clamp(2rem, 4vw, 3.8rem);
    }

    h3.cms-heading {
      font-size: clamp(1.5rem, 3vw, 2.5rem);
    }
  }
</style>
