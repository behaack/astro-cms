---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import type { PageDocument, PageSearchVisibility } from "../cms/document-types";

interface Props {
  document?: PageDocument;
  title?: string;
  description?: string;
  searchVisibility?: PageSearchVisibility;
  canonical?: boolean;
}

const {
  document,
  title,
  description,
  searchVisibility,
  canonical = true,
} = Astro.props;
const headDocument: PageDocument =
  document ??
  ({
    schemaVersion: 1,
    route: Astro.url.pathname,
    title: title ?? "Astro-CMS",
    ...(description ? { description } : {}),
    content: [],
  } satisfies PageDocument);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      document={headDocument}
      titleOverride={document ? title : undefined}
      descriptionOverride={document ? description : undefined}
      searchVisibility={searchVisibility}
      canonical={canonical}
      siteName="Astro-CMS"
      locale="en_US"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="site-shell">
      <slot />
    </div>
  </body>
</html>
