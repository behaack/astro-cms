---
import {
  listLocalPageDocuments,
  readLocalPageDocument,
} from "../cms/local-page-store";
import EditorApp from "../editor/EditorApp";

const requestedRoute = Astro.url.searchParams.get("page") ?? "/";
const pageDocument = await readLocalPageDocument(requestedRoute);
const pages = await listLocalPageDocuments();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Constrained visual editing for native Astro components."
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page editor · Astro-CMS</title>
  </head>
  <body>
    <EditorApp
      initialDocument={pageDocument}
      initialPages={pages}
      client:only="react"
    />
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    color: #17201d;
    background: #f4f6f2;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }
</style>
