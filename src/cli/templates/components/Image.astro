---
interface Props {
  src: string;
  alt: string;
  aspect?: "landscape" | "square";
  editorId?: string;
}

const { src, alt, aspect = "landscape", editorId } = Astro.props;
---

<figure
  class:list={["cms-image", `cms-image--${aspect}`]}
  data-astro-cms-node={editorId}
>
  <img src={src} alt={alt} loading="lazy" />
</figure>

<style>
  .cms-image {
    width: 100%;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 1rem;
    background: #e6efea;
  }

  .cms-image--landscape {
    aspect-ratio: 2 / 1;
  }

  .cms-image--square {
    max-width: 38rem;
    aspect-ratio: 1;
  }

  .cms-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
</style>
