---
interface Props {
  tone?: "light" | "dark" | "accent";
  width?: "standard" | "narrow";
  editorId?: string;
  editorSlot?: string;
}

const {
  tone = "light",
  width = "standard",
  editorId,
  editorSlot,
} = Astro.props;
---

<section
  class:list={["cms-section", `cms-section--${tone}`]}
  data-astro-cms-node={editorId}
>
  <div
    class:list={["cms-section__inner", `cms-section__inner--${width}`]}
    data-astro-cms-slot={editorSlot}
  >
    <slot />
  </div>
</section>

<style>
  .cms-section {
    padding: clamp(4rem, 10vw, 8rem) clamp(1.25rem, 5vw, 5rem);
  }

  .cms-section--light {
    color: #17201d;
    background: #f4f6f2;
  }

  .cms-section--dark {
    color: #f8faf8;
    background: #17201d;
  }

  .cms-section--accent {
    color: #10251e;
    background: #b8e4cf;
  }

  .cms-section__inner {
    margin-inline: auto;
  }

  .cms-section__inner--standard {
    max-width: 72rem;
  }

  .cms-section__inner--narrow {
    max-width: 46rem;
  }
</style>
