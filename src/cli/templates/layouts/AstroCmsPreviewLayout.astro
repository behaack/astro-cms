---
import type { PageDocument, PageSearchVisibility } from "@astro-cms/core/types";

import AstroCmsSeoHead from "../components/AstroCmsSeoHead.astro";

interface Props {
  document?: PageDocument;
  title?: string;
  description?: string;
  searchVisibility?: PageSearchVisibility;
  canonical?: boolean;
}

const {
  document,
  title,
  description,
  searchVisibility,
  canonical = true,
} = Astro.props;
const headDocument: PageDocument =
  document ??
  ({
    schemaVersion: 1,
    route: Astro.url.pathname,
    title: title ?? "Astro-CMS",
    ...(description ? { description } : {}),
    content: [],
  } satisfies PageDocument);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <AstroCmsSeoHead
      document={headDocument}
      titleOverride={document ? title : undefined}
      descriptionOverride={document ? description : undefined}
      searchVisibility={searchVisibility}
      canonical={canonical}
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color: #17201d;
    background: #f4f6f2;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }
</style>
