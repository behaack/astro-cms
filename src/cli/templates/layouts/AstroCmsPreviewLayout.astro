---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A page assembled from approved native Astro components.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color: #17201d;
    background: #f4f6f2;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }
</style>
