---
import DocumentRenderer from "../components/renderer/DocumentRenderer.astro";
import { assertPageDocument } from "../cms/validation";
import homeDocumentJson from "../content/pages/home.json";
import BaseLayout from "../layouts/BaseLayout.astro";

const homeDocument = assertPageDocument(homeDocumentJson);
---

<BaseLayout
  title={`Preview · ${homeDocument.title}`}
  description={homeDocument.description}
>
  <header class="prototype-notice">
    <p>
      <strong>Astro preview mode.</strong> Component boundaries carry stable editor IDs.
    </p>
    <nav aria-label="Prototype links">
      <a href="/">Published view</a>
      <a href="/admin">Editor scaffold</a>
    </nav>
  </header>
  <DocumentRenderer document={homeDocument} editorMode />
</BaseLayout>

<style is:global>
  [data-astro-cms-node] {
    position: relative;
    outline: 1px dashed rgb(22 114 83 / 35%);
    outline-offset: -2px;
  }

  [data-astro-cms-node]:hover {
    outline: 2px solid #167253;
  }
</style>
