---
import {
  listLocalPageDocuments,
  readLocalPageDocument,
} from "../../cms/local-page-store";
import EditorApp from "../../editor/EditorApp";
import BaseLayout from "../../layouts/BaseLayout.astro";

const requestedRoute = Astro.url.searchParams.get("page") ?? "/";
const pageDocument = await readLocalPageDocument(requestedRoute);
const pages = await listLocalPageDocuments();
---

<BaseLayout
  title="Editor Scaffold · Astro-CMS"
  searchVisibility="noindex"
  canonical={false}
>
  <EditorApp
    initialDocument={pageDocument}
    initialPages={pages}
    client:only="react"
  />
</BaseLayout>
