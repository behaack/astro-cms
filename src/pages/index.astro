---
import DocumentRenderer from "../components/renderer/DocumentRenderer.astro";
import { readLocalPageDocument } from "../cms/local-page-store";
import BaseLayout from "../layouts/BaseLayout.astro";

const homeDocument = await readLocalPageDocument("/");
---

<BaseLayout document={homeDocument}>
  <header class="prototype-notice">
    <p>
      <strong>Native Astro output.</strong> No editor runtime is loaded on this page.
    </p>
    <nav aria-label="Prototype links">
      <a href="/preview">Preview metadata</a>
      <a href="/admin">Editor scaffold</a>
    </nav>
  </header>
  <DocumentRenderer document={homeDocument} />
</BaseLayout>
