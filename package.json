{
  "name": "@astro-cms/core",
  "version": "0.1.0",
  "description": "Constrained visual editing for native Astro components.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "astro-cms": "./src/cli/astro-cms.mjs"
  },
  "files": [
    "src/astro-cms-virtual.d.ts",
    "src/integration.ts",
    "src/cms/*.ts",
    "!src/cms/*.test.ts",
    "!src/cms/component-manifest.ts",
    "!src/cms/document-test-helpers.ts",
    "src/components/renderer",
    "src/cli/*.mjs",
    "!src/cli/*.test.mjs",
    "src/cli/templates",
    "src/editor",
    "src/package-routes",
    "src/pages/api",
    "README.md",
    "DISTRIBUTION.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/behaack/astro-cms.git"
  },
  "bugs": {
    "url": "https://github.com/behaack/astro-cms/issues"
  },
  "homepage": "https://github.com/behaack/astro-cms#readme",
  "exports": {
    "./integration": "./src/integration.ts",
    "./renderer": "./src/components/renderer/DocumentRenderer.astro",
    "./store": "./src/cms/local-page-store.ts",
    "./seo": "./src/cms/seo-metadata.ts",
    "./git": "./src/cms/git-publisher.ts",
    "./types": "./src/cms/document-types.ts",
    "./contract": "./src/cms/component-contract.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm check && pnpm test",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "grapesjs": "^0.23.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@astrojs/react": "^6.0.2",
    "astro": "^7.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.2",
    "@astrojs/react": "^6.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
